{
  "name": "@sdd-telemetry/worker",
  "version": "0.1.0",
  "private": true,
  "type": "commonjs",
  "main": "dist/main.js",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "once": "WORKER_ONCE=true node dist/main.js",
    "profile:rebuild-source-references": "tsx src/jobs/rebuild-source-references.ts",
    "profile:rebuild": "tsx src/jobs/profile-rebuild.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:integration": "vitest run test/integration",
    "lint": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@sdd-telemetry/api": "workspace:*",
    "mysql2": "^3.22.3",
    "pino": "^10.1.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@sdd-telemetry/config": "workspace:*",
    "@types/node": "^22.19.3",
    "tsx": "^4.22.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.6"
  }
}
