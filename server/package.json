{
  "name": "@sdd-telemetry/server",
  "version": "0.1.0",
  "private": true,
  "type": "commonjs",
  "main": "dist/bootstrap.js",
  "scripts": {
    "dev": "tsx watch src/bootstrap.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/bootstrap.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --passWithNoTests",
    "test:api": "vitest run test/integration/api-contract.test.ts",
    "lint": "tsc --noEmit -p tsconfig.json",
    "db:migrate": "tsx src/infrastructure/mysql/run-migrations.ts",
    "db:seed": "tsx src/infrastructure/mysql/seed.ts",
    "db:verify": "tsx src/infrastructure/mysql/verify-schema.ts",
    "db:reset-local": "CONFIRM_RESET=1 tsx src/infrastructure/mysql/reset-local-data.ts",
    "db:reset-derived": "CONFIRM_RESET_DERIVED=1 tsx src/infrastructure/mysql/reset-derived-data.ts",
    "db:reclean": "tsx src/infrastructure/mysql/reset-and-reclean.ts",
    "db:import-legacy-sqlite": "tsx src/infrastructure/mysql/import-legacy-sqlite-raw.ts",
    "auth:bootstrap-admin": "tsx src/infrastructure/mysql/bootstrap-auth-admin.ts"
  },
  "dependencies": {
    "@midwayjs/bootstrap": "^4.1.0",
    "@midwayjs/core": "^4.1.0",
    "@midwayjs/koa": "^4.1.0",
    "@midwayjs/logger": "^4.0.1",
    "@midwayjs/typeorm": "^4.1.0",
    "@sdd-telemetry/api": "workspace:*",
    "bullmq": "^5.76.8",
    "dotenv": "^17.4.2",
    "ioredis": "^5.10.1",
    "mysql2": "^3.22.3",
    "pino": "^10.1.0",
    "reflect-metadata": "^0.2.2",
    "typeorm": "^0.3.29",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@sdd-telemetry/config": "workspace:*",
    "@types/node": "^22.19.3",
    "tsx": "^4.22.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.6"
  }
}
